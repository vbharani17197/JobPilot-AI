# =============================================================
# JobPilot-AI secrets. Copy this file to ".env" and fill in.
# NEVER commit your real .env to git.
# =============================================================

# --- Adzuna (REQUIRED - primary source) ----------------------
# Get free credentials at: https://developer.adzuna.com/signup
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# --- Anthropic Claude API (REQUIRED for AI fit scoring) ------
# This powers the agentic layer: Claude reads each job and reasons
# about fit against your resume. Get a key at:
# https://console.anthropic.com/  ->  API Keys
# Cost is tiny (Haiku 4.5): a daily run of ~50 jobs is well under 1 cent.
# To run WITHOUT AI, set llm.enabled: false in config/settings.yaml.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- JSearch via RapidAPI (OPTIONAL - Indeed/Glassdoor coverage)
# Subscribe (free tier) at:
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Then set sources.jsearch.enabled: true in config/settings.yaml
JSEARCH_API_KEY=your_rapidapi_key_here
